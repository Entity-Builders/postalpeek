{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postal-peek",
  "main": "./src/worker.ts",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
