{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postalpeek-image-proxy",
  "main": "./worker.ts",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "postalpeek-assets",
    },
  ],
  "routes": [
    {
      "pattern": "img.postalpeek.app/*",
      "zone_name": "postalpeek.app",
    },
  ],
}
